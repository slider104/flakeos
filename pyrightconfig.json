// Settings for Zed's Python checker (basedpyright). Only matters while
// editing the two Python files here: modules/programs/ydotool/autoclicker.py
// and modules/programs/noctalia/noctalia-changes.py.
{
  // How strict. Zed normally uses "standard", but with this file present
  // basedpyright ignores Zed's settings and would use its much stricter default.
  "typeCheckingMode": "standard",

  // The autoclicker's python with its libraries (gi, evdev) and their type
  // descriptions: /etc/autoclicker/python, made by programs/ydotool/ydotool.nix.
  "venvPath": "/etc/autoclicker",
  "venv": "python",

  // Libraries that are not in that python, one folder per library:
  // tomlkit, which noctalia-changes.py imports (programs/noctalia/noctalia.nix).
  "extraPaths": ["/etc/noctalia-changes/python-libs"],

  // gi.repository (Gtk, Adw, GLib) is generated when the app starts, so
  // there is no source file to find, only the type descriptions. Don't warn.
  "reportMissingModuleSource": false
}
