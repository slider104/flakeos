{
  "settingsVersion": 59,
  "bar": {
    "position": "top",
    "density": "default",
    "useSeparateOpacity": true,
    "backgroundOpacity": 0,
    "capsuleOpacity": 0.5
  },
  "general": {
    "animationSpeed": 2,
    "radiusRatio": 0.2,
    "iRadiusRatio": 0.2,
    "lockOnSuspend": true,
    "showChangelogOnStartup": false,
    "telemetryEnabled": false
  },
  "ui": {
    "fontDefault": "Noto Sans",
    "fontFixed": "JetBrainsMono Nerd Font",
