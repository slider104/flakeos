    "translucentWidgets": true
  },
  "location": {
    "name": "Gütersloh",
    "autoLocate": false,
    "use12hourFormat": false,
    "firstDayOfWeek": 1
  },
  "wallpaper": {
    "enabled": true,
    "directory": "/etc/wallpapers",
    "skipStartupTransition": true
  },
  "dock": {
    "enabled": false
  },
  "colorSchemes": {
    "useWallpaperColors": false,
    "darkMode": true,
    "syncGsettings": false
  },
  "templates": {
    "activeTemplates": [],
    "enableUserTheming": false
  },
  "hooks": {
    "enabled": true,
    "startup": "noctalia-changes --snapshot"
  }
