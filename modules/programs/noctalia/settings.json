{
  "settingsVersion": 59,
  "bar": {
    "position": "top",
    "density": "default",
    "useSeparateOpacity": true,
    "backgroundOpacity": 0,
    "capsuleOpacity": 0.5,
    "widgets": {
      "left": [
        {
          "id": "Launcher",
          "useDistroLogo": true,
          "enableColorization": true,
          "colorizeSystemIcon": "primary"
        },
        { "id": "SystemMonitor" },
        { "id": "ActiveWindow" },
        { "id": "MediaMini" }
      ],
      "center": [
        { "id": "Workspace" }
      ],
      "right": [
        { "id": "Tray" },
        { "id": "NotificationHistory" },
        { "id": "Volume" },
        { "id": "Brightness" },
        { "id": "Clock" },
        {
          "id": "ControlCenter",
          "icon": "power",
          "enableColorization": true,
          "colorizeSystemIcon": "primary"
        }
      ]
    }
  },
  "general": {
    "animationSpeed": 2,
    "radiusRatio": 0.2,
    "iRadiusRatio": 0.2,
    "lockOnSuspend": true,
    "showChangelogOnStartup": false,
    "telemetryEnabled": false
  },
  "ui": {
    "fontDefault": "Noto Sans",
    "fontFixed": "JetBrainsMono Nerd Font",
    "panelBackgroundOpacity": 1,
    "translucentWidgets": true
  },
  "location": {
    "name": "Gütersloh",
    "autoLocate": false,
    "use12hourFormat": false,
    "firstDayOfWeek": 1
  },
  "wallpaper": {
    "enabled": true,
    "directory": "/etc/wallpapers",
    "skipStartupTransition": true
  },
  "dock": {
    "enabled": false
  },
  "colorSchemes": {
    "useWallpaperColors": false,
    "darkMode": true,
    "syncGsettings": false
  },
  "templates": {
    "activeTemplates": [],
    "enableUserTheming": false
  },
  "hooks": {
    "enabled": true,
    "startup": "noctalia-changes --snapshot"
  }
}
