# zshrc for the wrapped zsh. It lives in the store and replaces ~/.zshrc,
# which is never read. The plugins are sourced after this file (see zsh.nix).

# --- History ------------------------------------------------------------------
# ZDOTDIR is read-only (the store), so history lives in ~/.local/state.
HISTFILE="$HOME/.local/state/zsh/history"
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space

# --- Completion -----------------------------------------------------------------
autoload -Uz compinit
[[ -d $HOME/.cache/zsh ]] || mkdir -p $HOME/.cache/zsh
compinit -d "$HOME/.cache/zsh/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# --- Behaviour ------------------------------------------------------------------
setopt auto_cd interactive_comments
bindkey -e
bindkey '^[[H' beginning-of-line   # Home
bindkey '^[[F' end-of-line         # End
bindkey '^[[3~' delete-char        # Delete
bindkey '^[[1;5C' forward-word     # Ctrl+Right
bindkey '^[[1;5D' backward-word    # Ctrl+Left

# --- Prompt ---------------------------------------------------------------------
# Two lines: a blue pill (user@host) joined to a grey one (directory), then
# the input arrow, green after success, red when the last command failed:
#
#    slider@zeus    ~/flakeos
#   ❯
#
# The round ends and icons are Nerd Font glyphs (the terminal font, see the
# palette), written as \u codes. Colours are terminal colour numbers, so
# they follow the palette: blue = 4, grey = 8 (bright black), white = 15.
# Deep directories are shortened to their last 3 parts: …/a/b/c.
# The TTY (Ctrl+Alt+F2, for rescues) has no Nerd Font, so it gets a plain
# version: user@host ~/dir, then > in green/red.
() {
  if [[ $TERM == linux ]]; then
    PROMPT='%F{4}%n@%m%f %~'$'\n''%(?.%F{2}.%F{1})>%f '
    return
  fi
  local round_l=$'' round_r=$'' join=$''
  local icon_user=$'' icon_dir=$''
  local dir='%(4~|…/%3~|%~)'
  PROMPT="%F{4}${round_l}%K{4}%F{15} ${icon_user} %n@%m %F{4}%K{8}${join}%F{15} ${icon_dir} ${dir} %k%F{8}${round_r}%f"$'\n'"%(?.%F{2}.%F{1})❯%f "
}

# --- Aliases --------------------------------------------------------------------
alias ls='ls --color=auto'
alias ll='ls -lah'
alias grep='grep --color=auto'

# --- NixOS ----------------------------------------------------------------------
# The flake picks the config matching this machine's hostname.
# Every command shows its output as usual AND saves it to
# ~/flakeos/logs/<kind>_<date>.log (ignored by git, delete them whenever).

# nixlog <kind> <command...>: run the command, copy its output into a log.
# Returns the command's own exit code (a plain `| tee` would always report
# success), so `nup` only rebuilds if the update worked.
nixlog() {
  local kind=$1; shift
  local log=~/flakeos/logs/${kind}_$(date +%F-%T).log
  mkdir -p ~/flakeos/logs
  "$@" 2>&1 | tee "$log"
  local code=${pipestatus[1]}
  echo "log: $log"
  return $code
}

alias nrs='nixlog rebuild sudo nixos-rebuild switch --flake ~/flakeos'        # rebuild + switch now
alias nrb='nixlog rebuild sudo nixos-rebuild boot --flake ~/flakeos'          # rebuild, use on next boot
alias nck='nixlog check_flake nix flake check ~/flakeos'                      # check the config
alias ncg='nixlog garbage_collect sudo nix-collect-garbage --delete-older-than 30d'  # clean old generations
nup() {                                                                       # update inputs + rebuild
  nixlog update sh -c 'nix flake update --flake ~/flakeos && sudo nixos-rebuild boot --flake ~/flakeos'
}
