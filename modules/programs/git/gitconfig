# Global git config, baked into the wrapped git (GIT_CONFIG_GLOBAL).
# ~/.gitconfig is ignored and `git config --global` can't write here:
# edit this file and rebuild instead.

[user]
	name = slider
	email = matze33442@gmx.de

[init]
	defaultBranch = main

[pull]
	rebase = true

[core]
	editor = nano

# Clone/pull GitHub repos over https (works with no key, e.g. on the ISO),
# but push over SSH with your key (~/.ssh/id_ed25519). An https push would
# ask for a username + token, which Zed can't answer.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
