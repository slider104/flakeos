// Zed defaults for flakeos. Docs: https://zed.dev/docs/configuring-zed
//
// Installed as ~/.config/zed/global_settings.json (a symlink the wrapper
// refreshes every time Zed starts). Zed itself never writes this file.
// Anything you change inside Zed goes to ~/.config/zed/settings.json and
// overrides these defaults. To make a change permanent for every install,
// put it here instead and rebuild.
{
  // Generated from the palette (see zed.nix), so it matches adw-gtk3-dark.
  // A built-in alternative, if you ever want one: "Ayu Dark".
  "theme": "Adwaita Dark (palette)",

  "ui_font_family": "Noto Sans",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },

  // Nix support. Zed installs the "nix" extension by itself; the language
  // server and formatter come from programs/nix-tools.
  "auto_install_extensions": {
    "nix": true
  },
  "languages": {
    "Nix": {
      // nixd only ("!nil" = don't start nil): one set of errors, not two.
      "language_servers": ["nixd", "!nil"],
      // Format on save with alejandra, the same as `nix fmt .`.
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet", "--"]
        }
      }
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        // Where nixd learns package names and NixOS options for completion
        // and hover docs: this flake's own nixpkgs, and zeus' options (the
        // hosts share almost all modules). Change the path if the repo moves.
        "nixpkgs": {
          "expr": "import (builtins.getFlake \"/home/slider/flakeos\").inputs.nixpkgs { }"
        },
        "options": {
          "nixos": {
            "expr": "(builtins.getFlake \"/home/slider/flakeos\").nixosConfigurations.zeus.options"
          }
        }
      }
    }
  },

  // Updates come from nixpkgs (`nup`), not from Zed itself.
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
